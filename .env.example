# Copy to .env.local and never commit it.

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY_BASE64=

# 1 = use canned AI outputs, no network needed. Use this for rehearsals and as the demo fallback.
MOCK_AI=1

# Used only inside lib/ai.ts when MOCK_AI is off (the /demo toggle). Pseudonymised text only.
# The real key stays in your local .env.local; never commit actual keys.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Optional. MyMemory (the consultation translator) allows more free translations per day with a contact email.
MYMEMORY_EMAIL=

# Local SQLite file
DB_PATH=./care-loop.db
