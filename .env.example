# Copy to .env.local and never commit it.

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY_BASE64=

# 1 = use canned AI outputs, no network needed. Use this for rehearsals and as the demo fallback.
MOCK_AI=1

# Used only inside lib/ai.ts when MOCK_AI is off (the /demo toggle). Pseudonymised text only; never commit the key.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Speech-to-text: OpenWhispr desktop app running, CLI installed (npm i -g @openwhispr/cli).
# Optional local model id, e.g. turbo (download it in OpenWhispr first). Empty = the app's default.
OPENWHISPR_MODEL=

# Local SQLite file
DB_PATH=./care-loop.db
